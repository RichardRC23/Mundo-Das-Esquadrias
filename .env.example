# Preserve seu .env existente; este arquivo contém apenas exemplos.
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Escolha mercadopago para as novas compras. O Stripe existente pode ser preservado.
PAYMENT_PROVIDER=mercadopago
# Só ativado quando todos os campos abaixo e APP_ORIGIN com HTTPS estiverem prontos.
# Não copie tokens para o chat, JavaScript público ou Git.
MP_ENVIRONMENT=test
MP_ACCESS_TOKEN=
MP_COLLECTOR_ID=
MP_WEBHOOK_SECRET=
# Somente publica o arquivo oficial de associação do domínio, NÃO ativa Apple Pay.
# Arquivo: data/apple-pay/domain-association.txt (obtido da Apple).
APPLE_PAY_DOMAIN_VERIFICATION=0
# Integração opcional. Configure inicialmente em ambiente de testes.
STRIPE_SECRET_KEY=
# Preços únicos criados no Stripe (identificadores price_...).
STRIPE_QUOTE_SINGLE_PRICE_ID=
STRIPE_QUOTE_PACK_PRICE_ID=
# Em produção HTTPS atrás de UM proxy confiável: TRUST_PROXY=1
